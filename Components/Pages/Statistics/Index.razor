@page "/assistance/statistics"
@rendermode InteractiveServer
@using GlpiNg.Modules.Assistance.Services

<PageTitle>Statistiques — GlpiNg</PageTitle>

<div class="glpi-stats">
    @* Tous les filtres sur une ligne, au-dessus de ce qu'ils filtrent. *@
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-center gap-2">
            <select class="form-select" style="width: auto;" value="@_itemType" @onchange="OnItemTypeChangedAsync">
                <option value="tickets">Tickets</option>
                <option value="problems">Problèmes</option>
                <option value="changes">Changements</option>
            </select>

            <select class="form-select" style="width: auto;" value="@_preset" @onchange="OnPresetChanged">
                <option value="30d">30 derniers jours</option>
                <option value="3m">3 derniers mois</option>
                <option value="12m">12 derniers mois</option>
                <option value="year">Année en cours</option>
                <option value="lastyear">Année précédente</option>
                <option value="custom">Personnalisée</option>
            </select>

            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary">du</span>
                <input type="date" class="form-control" style="width: auto;"
                       value="@_from.ToString("yyyy-MM-dd")" @onchange="OnFromChanged" />
                <span class="text-secondary">au</span>
                <input type="date" class="form-control" style="width: auto;"
                       value="@_to.ToString("yyyy-MM-dd")" @onchange="OnToChanged" />
            </div>
        </div>
    </div>

    @if (_summary is { } summary)
    {
        <div class="glpi-stats-tiles mb-3">
            <div class="glpi-stats-tile">
                <div class="glpi-stats-tile-label">Ouverts sur la période</div>
                <div class="glpi-stats-tile-value">@summary.Opened.ToString("N0", French)</div>
            </div>
            <div class="glpi-stats-tile">
                <div class="glpi-stats-tile-label">Résolus sur la période</div>
                <div class="glpi-stats-tile-value">@summary.Solved.ToString("N0", French)</div>
            </div>
            <div class="glpi-stats-tile">
                <div class="glpi-stats-tile-label">Clos sur la période</div>
                <div class="glpi-stats-tile-value">@summary.Closed.ToString("N0", French)</div>
            </div>
            <div class="glpi-stats-tile">
                <div class="glpi-stats-tile-label">En cours aujourd'hui</div>
                <div class="glpi-stats-tile-value">@summary.Backlog.ToString("N0", French)</div>
                @if (summary.Overdue > 0)
                {
                    @* Statut : icône et libellé, jamais la couleur seule. *@
                    <div class="glpi-stats-tile-note text-danger">
                        <i class="ti ti-alert-triangle me-1"></i>@summary.Overdue en retard
                    </div>
                }
                else
                {
                    <div class="glpi-stats-tile-note text-secondary">
                        <i class="ti ti-circle-check me-1"></i>aucun en retard
                    </div>
                }
            </div>
            <div class="glpi-stats-tile">
                <div class="glpi-stats-tile-label">Délai moyen de résolution</div>
                <div class="glpi-stats-tile-value">@ItilStatistics.FormatDuration(summary.AverageResolution)</div>
                @if (summary.MedianResolution is not null)
                {
                    <div class="glpi-stats-tile-note text-secondary">médiane @ItilStatistics.FormatDuration(summary.MedianResolution)</div>
                }
            </div>
            @if (IsTickets)
            {
                <div class="glpi-stats-tile">
                    <div class="glpi-stats-tile-label">Résolus dans les délais (SLA)</div>
                    <div class="glpi-stats-tile-value">@Percent(summary.SlaMet, summary.SlaMeasured)</div>
                    <div class="glpi-stats-tile-note text-secondary">
                        @(summary.SlaMeasured == 0
                            ? "aucun ticket résolu sous engagement"
                            : $"{summary.SlaMet} sur {summary.SlaMeasured} sous engagement")
                    </div>
                </div>
            }
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <h3 class="card-title mb-0">Évolution des @ItemsLabel</h3>
                    <div class="text-secondary small">
                        Par @(ItilStatistics.BucketSizeFor(_from, ToExclusive) switch
                        {
                            StatBucketSize.Day => "jour",
                            StatBucketSize.Week => "semaine",
                            _ => "mois",
                        }) — un même @ItemsLabel.TrimEnd('s') compte à sa date d'ouverture, de résolution et de clôture.
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="glpi-stats-legend">
                        <span><i class="glpi-stats-key glpi-stats-s1"></i>Ouverts</span>
                        <span><i class="glpi-stats-key glpi-stats-s2"></i>Résolus</span>
                        <span><i class="glpi-stats-key glpi-stats-s3"></i>Clos</span>
                    </div>
                    <button type="button" class="btn btn-sm" @onclick="() => _showTable = !_showTable">
                        <i class="ti @(_showTable ? "ti-chart-line" : "ti-table") me-1"></i>@(_showTable ? "Graphique" : "Tableau")
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (_showTable)
                {
                    <div class="table-responsive" style="max-height: 22rem;">
                        <table class="table table-sm table-vcenter mb-0">
                            <thead>
                                <tr>
                                    <th>Période</th>
                                    <th class="text-end">Ouverts</th>
                                    <th class="text-end">Résolus</th>
                                    <th class="text-end">Clos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (StatBucket bucket in _buckets)
                                {
                                    <tr>
                                        <td class="text-capitalize">@bucket.LongLabel</td>
                                        <td class="text-end glpi-stats-num">@bucket.Opened</td>
                                        <td class="text-end glpi-stats-num">@bucket.Solved</td>
                                        <td class="text-end glpi-stats-num">@bucket.Closed</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="glpi-stats-chart" @ref="_chartRef" @onmouseleave="() => _hovered = null">
                        <svg viewBox="0 0 @ChartWidth @ChartHeight" width="@ChartWidth" height="@ChartHeight" role="img"
                             aria-label="@($"Évolution des {ItemsLabel} ouverts, résolus et clos")">
                            @* Chaque <text> SVG est posé dans un <g> : en tête d'un bloc de code, Razor
                               prendrait la balise pour sa propre transition <text>. *@
                            @foreach (int tick in _yTicks)
                            {
                                double y = Y(tick);
                                <g>
                                    <line class="glpi-stats-grid" x1="@PlotLeft" x2="@PlotRight" y1="@F(y)" y2="@F(y)" />
                                    <text class="glpi-stats-axis" x="@(PlotLeft - 8)" y="@F(y + 4)" text-anchor="end">@tick.ToString("N0", French)</text>
                                </g>
                            }

                            @for (int index = 0; index < _buckets.Count; index += LabelStep)
                            {
                                <g>
                                    <text class="glpi-stats-axis" x="@F(X(index))" y="@(PlotBottom + 20)" text-anchor="middle">@_buckets[index].Label</text>
                                </g>
                            }

                            @if (_hovered is { } hoveredIndex)
                            {
                                <line class="glpi-stats-crosshair" x1="@F(X(hoveredIndex))" x2="@F(X(hoveredIndex))" y1="@PlotTop" y2="@PlotBottom" />
                            }

                            <polyline class="glpi-stats-line glpi-stats-s1" points="@Points(bucket => bucket.Opened)" />
                            <polyline class="glpi-stats-line glpi-stats-s2" points="@Points(bucket => bucket.Solved)" />
                            <polyline class="glpi-stats-line glpi-stats-s3" points="@Points(bucket => bucket.Closed)" />

                            @* Marqueurs au point survolé et en fin de courbe seulement : un point sur
                               chaque mesure chargerait le tracé sans rien apprendre de plus. *@
                            @foreach (int index in new[] { _buckets.Count - 1, _hovered ?? -1 }.Where(i => i >= 0).Distinct())
                            {
                                StatBucket bucket = _buckets[index];
                                <circle class="glpi-stats-dot glpi-stats-s1" cx="@F(X(index))" cy="@F(Y(bucket.Opened))" r="4" />
                                <circle class="glpi-stats-dot glpi-stats-s2" cx="@F(X(index))" cy="@F(Y(bucket.Solved))" r="4" />
                                <circle class="glpi-stats-dot glpi-stats-s3" cx="@F(X(index))" cy="@F(Y(bucket.Closed))" r="4" />
                            }

                            @foreach ((string label, int value, double y) in EndLabels)
                            {
                                <g>
                                    <text class="glpi-stats-endlabel" x="@(PlotRight + 10)" y="@F(y + 4)">@label @value</text>
                                </g>
                            }

                            @for (int index = 0; index < _buckets.Count; index++)
                            {
                                int captured = index;
                                <rect class="glpi-stats-hit" x="@F(X(index) - SlotWidth / 2)" y="@PlotTop" width="@F(SlotWidth)"
                                      height="@(PlotBottom - PlotTop)" @onmouseenter="() => _hovered = captured" />
                            }
                        </svg>

                        @if (_hovered is { } tooltipIndex && tooltipIndex < _buckets.Count)
                        {
                            StatBucket bucket = _buckets[tooltipIndex];
                            <div class="glpi-stats-tooltip" style="@TooltipStyle(tooltipIndex)">
                                <div class="fw-semibold text-capitalize mb-1">@bucket.LongLabel</div>
                                <div><i class="glpi-stats-key glpi-stats-s1"></i>Ouverts <span class="glpi-stats-num fw-semibold">@bucket.Opened</span></div>
                                <div><i class="glpi-stats-key glpi-stats-s2"></i>Résolus <span class="glpi-stats-num fw-semibold">@bucket.Solved</span></div>
                                <div><i class="glpi-stats-key glpi-stats-s3"></i>Clos <span class="glpi-stats-num fw-semibold">@bucket.Closed</span></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row row-cards">
            <div class="col-lg-6">
                <BreakdownTable Title="Par catégorie" DimensionLabel="Catégorie" Rows="_byCategory" />
            </div>
            <div class="col-lg-6">
                <BreakdownTable Title="Par technicien" DimensionLabel="Technicien" Rows="_byTechnician" />
            </div>
            <div class="col-lg-6">
                <BreakdownTable Title="Par priorité" DimensionLabel="Priorité" Rows="_byPriority" />
            </div>
            @if (IsTickets)
            {
                <div class="col-lg-6">
                    <BreakdownTable Title="Par type" DimensionLabel="Type" Rows="_byType" />
                </div>
            }
            <div class="col-lg-6">
                <div class="card glpi-stats-breakdown">
                    <div class="card-header">
                        <h3 class="card-title">En cours aujourd'hui, par statut</h3>
                    </div>
                    @if (_backlogByStatus.Count == 0)
                    {
                        <div class="card-body text-secondary small">Aucun @ItemsLabel.TrimEnd('s') en cours.</div>
                    }
                    else
                    {
                        int max = _backlogByStatus.Max(entry => entry.Count);
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0">
                                <tbody>
                                    @foreach ((string label, int count) in _backlogByStatus)
                                    {
                                        <tr>
                                            <td>@label</td>
                                            <td style="width: 55%;">
                                                <div class="glpi-stats-barcell">
                                                    <span class="glpi-stats-bartrack">
                                                        <span class="glpi-stats-bar" style="width: @BarWidth(count, max);"></span>
                                                    </span>
                                                    <span class="glpi-stats-num">@count</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <p class="hint mt-3">
            Répartitions : ouverts et résolus sur la période, délai moyen de ceux qui y ont été résolus.
            Seuls les objets de votre périmètre d'entités sont comptés.
        </p>
    }
</div>

@code {
    /// <summary>Coordonnée SVG : toujours un point décimal, quelle que soit la culture du serveur.</summary>
    private static string F(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
