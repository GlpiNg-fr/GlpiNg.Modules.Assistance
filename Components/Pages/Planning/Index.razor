@page "/assistance/planning"
@rendermode InteractiveServer

<PageTitle>Planning — GlpiNg</PageTitle>

<div class="card glping-planning">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="btn-list align-items-center">
            <div class="btn-group">
                <button type="button" class="btn btn-icon" title="Semaine précédente" @onclick="PreviousWeekAsync">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <button type="button" class="btn" @onclick="TodayAsync">Aujourd'hui</button>
                <button type="button" class="btn btn-icon" title="Semaine suivante" @onclick="NextWeekAsync">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>
            <h3 class="card-title mb-0 ms-2">@WeekLabel</h3>
        </div>

        <div class="btn-list align-items-center">
            <select class="form-select" style="width: auto;" value="@_technicianFilter" @onchange="OnTechnicianChangedAsync">
                @if (_currentUserId is not null)
                {
                    <option value="me">Mon planning</option>
                }
                <option value="all">Tous les techniciens</option>
                @foreach (var user in _users)
                {
                    <option value="@user.Id">@user.Name</option>
                }
            </select>

            <label class="form-check form-switch align-self-center mb-0">
                <input class="form-check-input" type="checkbox" checked="@_showDone"
                       @onchange="@((ChangeEventArgs e) => OnShowDoneChangedAsync((bool)(e.Value ?? false)))" />
                <span class="form-check-label">Tâches terminées</span>
            </label>

            <div class="glping-planning-legend">
                <span><i class="glping-planning-swatch glping-planning-ticket"></i>Ticket</span>
                <span><i class="glping-planning-swatch glping-planning-problem"></i>Problème</span>
                <span><i class="glping-planning-swatch glping-planning-change"></i>Changement</span>
            </div>
        </div>
    </div>

    <div class="glping-planning-body">
        <div class="glping-planning-grid">
            <div class="glping-planning-head">
                <div class="glping-planning-gutter"></div>
                @foreach (DateTime day in Days)
                {
                    <div class="glping-planning-dayname @(day == Today ? "is-today" : "")">
                        @day.ToString("ddd d", French)
                    </div>
                }
            </div>

            <div class="glping-planning-hours">
                <div class="glping-planning-gutter">
                    @for (int hour = _firstHour; hour < _lastHour; hour++)
                    {
                        <div class="glping-planning-hourlabel" style="height: @(HourHeight)px;">@($"{hour:00}:00")</div>
                    }
                </div>

                @foreach (DateTime day in Days)
                {
                    <div class="glping-planning-day @(day == Today ? "is-today" : "")"
                         style="height: @((_lastHour - _firstHour) * HourHeight)px; background-size: 100% @(HourHeight)px;">
                        @if (NowLineStyle(day) is { } nowStyle)
                        {
                            <div class="glping-planning-now" style="@nowStyle" title="Maintenant"></div>
                        }

                        @foreach (PlannedTask entry in _planned.Where(entry => entry.Day == day))
                        {
                            ItilTask task = entry.Task;
                            <button type="button"
                                    class="glping-planning-event @TypeCss(task.ItemType) @SizeCss(entry) @(task.State == ItilTaskState.Done ? "is-done" : "")"
                                    style="@StyleOf(entry)"
                                    title="@($"{entry.Start:HH:mm}–{entry.End:HH:mm} · {task.Content}\n{entry.Parent}\n{NameOfUser(task.AssignedUserId)}")"
                                    @onclick="() => OpenAsync(task, entry.Parent)">
                                <span class="glping-planning-time">
                                    @($"{entry.Start:HH:mm}–{entry.End:HH:mm}")
                                    @if (task.State == ItilTaskState.Done)
                                    {
                                        <i class="ti ti-check ms-1" title="Terminée"></i>
                                    }
                                </span>
                                <span class="glping-planning-title">@task.Content</span>
                                <span class="glping-planning-parent"><i class="ti @TypeIcon(task.ItemType) me-1"></i>@entry.Parent</span>
                                @if (_technicianFilter == "all")
                                {
                                    <span class="glping-planning-parent"><i class="ti ti-user me-1"></i>@NameOfUser(task.AssignedUserId)</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <aside class="glping-planning-side">
            <div class="glping-planning-side-title">
                <i class="ti ti-calendar-plus me-1"></i>À planifier
                <span class="badge bg-secondary-lt ms-1">@_unplanned.Count</span>
            </div>
            @if (_unplanned.Count == 0)
            {
                <p class="text-secondary small mb-0">Aucune tâche ouverte sans date.</p>
            }
            else
            {
                @foreach (UnplannedTask entry in _unplanned)
                {
                    ItilTask task = entry.Task;
                    <button type="button" class="glping-planning-unplanned @TypeCss(task.ItemType)"
                            @onclick="() => OpenAsync(task, entry.Parent)">
                        <span class="glping-planning-title">@task.Content</span>
                        <span class="glping-planning-parent"><i class="ti @TypeIcon(task.ItemType) me-1"></i>@entry.Parent</span>
                        <span class="glping-planning-parent"><i class="ti ti-user me-1"></i>@NameOfUser(task.AssignedUserId)</span>
                    </button>
                }
            }
            <p class="hint mt-3 mb-0">
                Les tâches se créent sur la fiche de leur ticket, problème ou changement ; elles se
                planifient ici. Sans heure de fin, une tâche occupe une heure.
            </p>
        </aside>
    </div>
</div>

<div class="modal fade" id="planTaskModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-calendar-event me-2"></i>Planifier la tâche</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            @if (_editing is not null)
            {
                <div class="modal-body">
                    @if (_editError is not null)
                    {
                        <div class="alert alert-danger">@_editError</div>
                    }

                    <p class="fw-semibold mb-1">@_editing.Content</p>
                    <p class="mb-3">
                        <a href="@UrlOf(_editing)" class="text-secondary">
                            <i class="ti @TypeIcon(_editing.ItemType) me-1"></i>@_editingParent
                        </a>
                    </p>

                    <div class="glping-fiche-field">
                        <label>Début</label>
                        <input class="form-control" type="datetime-local" @bind="_editStart" />
                    </div>
                    <div class="glping-fiche-field">
                        <label>Fin</label>
                        <input class="form-control" type="datetime-local" @bind="_editEnd" />
                    </div>
                    <div class="glping-fiche-field">
                        <label>Technicien</label>
                        <select class="form-select" @bind="_editUserId">
                            <option value="0">—</option>
                            @foreach (var user in _users)
                            {
                                <option value="@user.Id">@user.Name</option>
                            }
                        </select>
                    </div>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" checked="@_editDone"
                               @onchange="@((ChangeEventArgs e) => _editDone = (bool)(e.Value ?? false))" />
                        <span class="form-check-label">Tâche terminée</span>
                    </label>
                    <p class="hint mt-2 mb-0">Vider le début retire la tâche du planning : elle repasse dans « À planifier ».</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-warning" @onclick="SaveTaskAsync">
                        <i class="ti ti-device-floppy me-1"></i>Enregistrer
                    </button>
                </div>
            }
        </div>
    </div>
</div>
