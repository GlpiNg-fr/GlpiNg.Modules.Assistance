@page "/config/calendars"
@rendermode InteractiveServer

<PageTitle>@T("Calendriers — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>@T("Rechercher")
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" class="form-control" placeholder="@(T("Nom, commentaire..."))"
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="btn-list align-items-center">
            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newCalendarModal">
                <i class="ti ti-plus me-1"></i>@T("Ajouter")
            </button>
        </div>
    </div>

    @* flex-grow-0 : la carte est une colonne flex dont le corps s'étirerait sinon, poussant le
       tableau vers le bas de l'écran. *@
    <div class="card-body border-bottom py-3 flex-grow-0">
        <p class="text-secondary mb-0">
            @T("Les heures pendant lesquelles le service travaille. Un niveau de service s'appuie dessus : « 4 heures » sur un incident ouvert vendredi à 17 h veut alors dire lundi matin, et non samedi soir.")
        </p>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3 mb-0">@_error</div>
    }

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>@T("Nom")</th>
                    <th>@T("Plages")</th>
                    <th>@T("Heures par semaine")</th>
                    <th>@T("Fermetures")</th>
                    <th>@T("Commentaire")</th>
                    <th style="width: 6rem;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-secondary py-4">@T("Aucun calendrier.")</td></tr>
                }
                else
                {
                    @foreach (Calendar calendar in _filtered)
                    {
                        <tr>
                            <td>
                                <a href="@($"/config/calendars/{calendar.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-calendar-time me-1 text-secondary"></i>@calendar.Name
                                </a>
                            </td>
                            <td class="text-secondary">
                                @if (calendar.IsEmpty)
                                {
                                    @* Un calendrier vide n'ouvre jamais : une échéance calculée
                                       dessus n'arriverait pas. Le dire ici, pas à l'usage. *@
                                    <span class="badge bg-warning-lt">@T("Aucune plage")</span>
                                }
                                else
                                {
                                    @calendar.Segments.Count
                                }
                            </td>
                            <td class="text-secondary">@WeeklyHours(calendar)</td>
                            <td class="text-secondary">@calendar.Holidays.Count</td>
                            <td class="text-secondary">@calendar.Comment</td>
                            <td class="text-nowrap">
                                <a class="btn btn-icon btn-sm" title="@(T("Ouvrir"))" href="@($"/config/calendars/{calendar.Id}")">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                <div class="dropdown d-inline-block">
                                    <button type="button" class="btn btn-icon btn-sm text-danger"
                                            data-bs-toggle="dropdown" aria-expanded="false" title="@(T("Supprimer"))">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 280px;">
                                        <p class="mb-2">@T("Supprimer ce calendrier, ses plages et ses fermetures ?")</p>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                    @onclick="() => DeleteAsync(calendar.Id)">@T("Supprimer")</button>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newCalendarModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-calendar-time me-2"></i>@T("Nouvel élément - Calendrier")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                <div class="glping-fiche-field">
                    <label>@T("Nom")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                    <input class="form-control" @bind="_newCalendar.Name" @bind:event="oninput" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Commentaire")</label>
                    <textarea class="form-control" rows="3" @bind="_newCalendar.Comment"></textarea>
                </div>
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_seedStandardWeek"
                           @onchange="@((ChangeEventArgs e) => _seedStandardWeek = (bool)(e.Value ?? false))" />
                    <span class="form-check-label">@T("Pré-remplir une semaine ouvrée (lundi-vendredi, 9 h - 18 h)")</span>
                </label>
                <p class="hint">
                    @T("Un calendrier sans plage n'ouvre jamais : autant partir d'une semaine plausible, quitte à la corriger sur la fiche.")
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newCalendar.Name)"
                        @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
</div>
