@* Onglet « Historique » d'une fiche d'assistance. Les objets du module partagent une table
   d'historique ; seule la projection en lignes est commune, d'où ce composant qui reçoit des
   lignes déjà lues plutôt qu'un type d'entité. *@

@if (Rows.Count == 0)
{
    <div class="glping-config-placeholder">
        <i class="ti ti-history"></i>
        <p class="mb-0">@T("Aucune modification enregistrée.")</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-vcenter">
            <thead>
                <tr>
                    <th style="width: 12rem;">@T("Date")</th>
                    <th style="width: 10rem;">@T("Auteur")</th>
                    <th style="width: 14rem;">@T("Champ")</th>
                    <th>@T("Modification")</th>
                </tr>
            </thead>
            <tbody>
                @* Ordre et écriture des dates selon les préférences (« Ordre de l'historique »,
                   format, fuseau) : les pages passent leurs lignes dans n'importe quel ordre. *@
                @foreach (HistoryRow row in Display.Chronological(Rows, row => row.OccurredAt))
                {
                    <tr>
                        <td class="text-secondary">@Display.DateTime(row.OccurredAt)</td>
                        <td class="text-secondary">@row.User</td>
                        <td>@row.Field</td>
                        <td class="text-secondary">@row.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<HistoryRow> Rows { get; set; } = [];
}
