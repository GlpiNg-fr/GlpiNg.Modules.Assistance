@page "/assistance/changes"
@rendermode InteractiveServer

<PageTitle>@T("Changements — GlpiNg")</PageTitle>

<div class="glping-list-page">
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between glping-list-toolbar">
        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-search me-1"></i>@T("Rechercher")
                </button>
                <div class="dropdown-menu p-3" style="min-width: 280px;">
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" class="form-control" placeholder="@(T("Titre, description, plans..."))"
                               @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
            </div>

            <select class="form-select" style="width: auto;" @bind="_statusFilter" @bind:after="ApplyFilter">
                <option value="open">@T("Changements ouverts")</option>
                <option value="all">@T("Tous les statuts")</option>
                @foreach (ChangeStatus status in ChangeLabels.Lifecycle)
                {
                    <option value="@((int)status)">@ChangeLabels.For(status)</option>
                }
            </select>

            <label class="form-check form-switch align-self-center mb-0">
                <input class="form-check-input" type="checkbox" checked="@_mineOnly"
                       @onchange="@((ChangeEventArgs e) => OnMineOnlyChanged((bool)(e.Value ?? false)))" />
                <span class="form-check-label">@T("Qui me sont attribués")</span>
            </label>

            @* Ce qui attend l'avis de l'utilisateur connecté : c'est la file de travail d'un
               approbateur, qui n'est souvent attribué à aucun des changements qu'il doit valider. *@
            <label class="form-check form-switch align-self-center mb-0">
                <input class="form-check-input" type="checkbox" checked="@_toApproveOnly"
                       @onchange="@((ChangeEventArgs e) => OnToApproveOnlyChanged((bool)(e.Value ?? false)))" />
                <span class="form-check-label">
                    @T("À approuver par moi")
                    @if (_awaitingMyApproval.Count > 0)
                    {
                        <span class="badge bg-warning-lt ms-1">@_awaitingMyApproval.Count</span>
                    }
                </span>
            </label>
        </div>

        <div class="btn-list align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                        disabled="@(_selectedIds.Count == 0)" title="@(T("Supprimer la sélection"))">
                    <i class="ti ti-trash"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 300px;">
                    <p class="mb-2">
                        @T("Supprimer {0} changement(s), leurs suivis, tâches et approbations ? Les tickets et problèmes rattachés ne sont pas supprimés, seulement détachés.", _selectedIds.Count)
                    </p>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm">@T("Annuler")</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteSelectedAsync">@T("Supprimer")</button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-icon" @onclick="LoadAsync" title="@(T("Rafraîchir"))">
                <i class="ti ti-refresh"></i>
            </button>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newChangeModal">
                <i class="ti ti-plus me-1"></i>@T("Ajouter")
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th style="width: 2.5rem;">
                        <input class="form-check-input m-0" type="checkbox" title="@(T("Sélectionner les éléments visibles"))"
                               checked="@AllSelected"
                               @onchange="@((ChangeEventArgs e) => ToggleSelectAll((bool)(e.Value ?? false)))" />
                    </th>
                    <th style="width: 5rem;">N°</th>
                    <th>@T("Titre")</th>
                    <th>@T("Statut")</th>
                    <th>@T("Approbation")</th>
                    <th>@T("Priorité")</th>
                    <th>@T("Catégorie")</th>
                    <th>@T("Attribué à")</th>
                    <th>@T("Ouvert le")</th>
                    <th>@T("Échéance")</th>
                </tr>
            </thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr><td colspan="10" class="text-center text-secondary py-4">@T("Aucun changement.")</td></tr>
                }
                else
                {
                    @foreach (Change change in _filtered)
                    {
                        <tr>
                            <td>
                                <input class="form-check-input m-0" type="checkbox" checked="@_selectedIds.Contains(change.Id)"
                                       @onchange="@((ChangeEventArgs e) => ToggleSelect(change.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td class="text-secondary">@change.Id</td>
                            <td>
                                <a href="@($"/assistance/changes/{change.Id}")" class="text-reset fw-semibold">
                                    <i class="ti ti-replace me-1 text-secondary"></i>@change.Name
                                </a>
                            </td>
                            <td><span class="badge @ChangeLabels.BadgeFor(change.Status)">@ChangeLabels.For(change.Status)</span></td>
                            <td>
                                @if (change.GlobalValidation == ChangeValidationStatus.None)
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="badge @ChangeLabels.BadgeFor(change.GlobalValidation)">@ChangeLabels.For(change.GlobalValidation)</span>
                                }
                            </td>
                            <td><span class="badge @ItilLabels.BadgeFor(change.Priority)">@ItilLabels.For(change.Priority)</span></td>
                            <td class="text-secondary">@change.Category?.Name</td>
                            <td class="text-secondary">@AssigneeOf(change)</td>
                            <td class="text-secondary">@Display.DateTime(change.OpenedAt)</td>
                            <td class="@(change.IsOverdue ? "text-danger fw-semibold" : "text-secondary")">
                                @(Display.LocalDateTime(change.DueDate) ?? "—")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
</div>

<div class="modal fade" id="newChangeModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-replace me-2"></i>@T("Nouvel élément - Changement")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(T("Fermer"))"></button>
            </div>
            <div class="modal-body">
                <div class="glping-fiche-field">
                    <label>@T("Titre")<span class="text-danger ms-1" title="@(T("Champ obligatoire"))">*</span></label>
                    <input class="form-control" @bind="_newChange.Name" @bind:event="oninput" />
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Description")</label>
                    <textarea class="form-control" rows="4" @bind="_newChange.Content"></textarea>
                </div>
                @* Deux colonnes au plus : un champ de fiche pose son libellé à côté de la liste, et à
                   trois par ligne les listes n'avaient plus la place d'afficher leur valeur. *@
                <div class="row">
                    <div class="col-md-6">
                        <div class="glping-fiche-field">
                            <label>@T("Urgence")</label>
                            <select class="form-select" value="@((int)_newChange.Urgency)"
                                    @onchange="@(e => _newChange.Urgency = (ItilLevel)int.Parse(e.Value?.ToString() ?? "3"))">
                                @foreach (ItilLevel level in Enum.GetValues<ItilLevel>())
                                {
                                    <option value="@((int)level)">@ItilLabels.For(level)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="glping-fiche-field">
                            <label>@T("Impact")</label>
                            <select class="form-select" value="@((int)_newChange.Impact)"
                                    @onchange="@(e => _newChange.Impact = (ItilLevel)int.Parse(e.Value?.ToString() ?? "3"))">
                                @foreach (ItilLevel level in Enum.GetValues<ItilLevel>())
                                {
                                    <option value="@((int)level)">@ItilLabels.For(level)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="glping-fiche-field">
                    <label>@T("Catégorie")</label>
                    <select class="form-select" @bind="_newCategoryId">
                        <option value="0">—</option>
                        @foreach (TicketCategory category in _categories)
                        {
                            <option value="@category.Id">@CategoryPath(category)</option>
                        }
                    </select>
                </div>
                <p class="hint">
                    @T("Analyse, plans de déploiement et de retour arrière, approbations, tickets et problèmes rattachés se renseignent sur la fiche. La priorité se calcule à partir de l'urgence et de l'impact.")
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" disabled="@string.IsNullOrWhiteSpace(_newChange.Name)"
                        @onclick="CreateAsync">
                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                </button>
            </div>
        </div>
    </div>
</div>
