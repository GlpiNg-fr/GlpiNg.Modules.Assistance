@page "/config/calendars/{CalendarId:int}"
@rendermode InteractiveServer

<PageTitle>@(_calendar is null ? "Calendrier" : _calendar.Name) — GlpiNg</PageTitle>

@if (_calendar is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">Calendrier introuvable.</div></div>
}
else
{
    <div class="glpi-fiche">
        <div class="glpi-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0">
                <i class="ti ti-calendar-time me-2"></i>@_calendar.Name
                @if (_calendar.IsEmpty)
                {
                    <span class="badge bg-warning-lt ms-2">Aucune plage</span>
                }
            </h2>
            <div class="btn-list">
                <a class="btn" href="/config/calendars"><i class="ti ti-arrow-left me-1"></i>Retour à la liste</a>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>Enregistrer
                </button>
            </div>
        </div>

        <div class="glpi-fiche-layout">
            <aside class="glpi-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glpi-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@label</span>
                        @if (count is { } value)
                        {
                            <span class="glpi-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glpi-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        <div class="glpi-fiche-field">
                            <label>Nom<span class="text-danger ms-1">*</span></label>
                            <input class="form-control" @bind="_calendar.Name" />
                        </div>
                        <div class="glpi-fiche-field">
                            <label>Commentaire</label>
                            <textarea class="form-control" rows="4" @bind="_calendar.Comment"></textarea>
                        </div>
                        <div class="glpi-fiche-field">
                            <label>Heures par semaine</label>
                            <input class="form-control" disabled value="@WeeklyHours()" />
                        </div>
                        @if (_usedBy.Count > 0)
                        {
                            <div class="glpi-fiche-field">
                                <label>Utilisé par</label>
                                <div>
                                    @foreach (ServiceLevel level in _usedBy)
                                    {
                                        <a class="badge bg-blue-lt me-1 text-reset"
                                           href="@($"/config/service-levels/{level.Id}")">@level.Name</a>
                                    }
                                </div>
                            </div>
                        }
                        break;

                    case "plages":
                        <p class="text-secondary">
                            Les heures travaillées, jour par jour. Plusieurs plages sur un même jour
                            sont permises : c'est ainsi qu'on ferme entre midi et deux.
                        </p>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label">Jour</label>
                                        <select class="form-select" @bind="_newSegmentDay">
                                            @foreach (DayOfWeek day in WeekOrder)
                                            {
                                                <option value="@((int)day)">@DayLabel(day)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Début</label>
                                        <input class="form-control" type="time" @bind="_newSegmentStart" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Fin</label>
                                        <input class="form-control" type="time" @bind="_newSegmentEnd" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100" @onclick="AddSegmentAsync">
                                            <i class="ti ti-plus me-1"></i>Ajouter
                                        </button>
                                    </div>
                                </div>
                                @if (_segmentError is not null)
                                {
                                    <div class="alert alert-danger mt-2 mb-0">@_segmentError</div>
                                }
                            </div>
                        </div>

                        @if (_calendar.Segments.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-calendar-off"></i>
                                <p class="mb-0">Aucune plage : ce calendrier n'ouvre jamais.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Jour</th>
                                            <th>Début</th>
                                            <th>Fin</th>
                                            <th>Durée</th>
                                            <th style="width: 3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (CalendarSegment segment in OrderedSegments)
                                        {
                                            <tr>
                                                <td>@DayLabel(segment.DayOfWeek)</td>
                                                <td class="text-secondary">@segment.StartTime.ToString("HH\\:mm")</td>
                                                <td class="text-secondary">@segment.EndTime.ToString("HH\\:mm")</td>
                                                <td class="text-secondary">@($"{segment.Duration.TotalHours:0.#} h")</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Supprimer"
                                                            @onclick="() => DeleteSegmentAsync(segment.Id)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "fermetures":
                        <p class="text-secondary">
                            Jours fériés, ponts et fermetures annuelles. Pendant ces jours, le
                            compteur d'un niveau de service ne tourne pas.
                        </p>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label">Intitulé</label>
                                        <input class="form-control" @bind="_newHolidayName" @bind:event="oninput" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Du</label>
                                        <input class="form-control" type="date" @bind="_newHolidayStart" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Au (inclus)</label>
                                        <input class="form-control" type="date" @bind="_newHolidayEnd" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100"
                                                disabled="@string.IsNullOrWhiteSpace(_newHolidayName)"
                                                @onclick="AddHolidayAsync">
                                            <i class="ti ti-plus me-1"></i>Ajouter
                                        </button>
                                    </div>
                                </div>
                                <label class="form-check mt-2 mb-0">
                                    <input class="form-check-input" type="checkbox" checked="@_newHolidayPerpetual"
                                           @onchange="@((ChangeEventArgs e) => _newHolidayPerpetual = (bool)(e.Value ?? false))" />
                                    <span class="form-check-label">
                                        Revient chaque année à la même date (1<sup>er</sup> mai, 14 juillet...)
                                    </span>
                                </label>
                                @if (_holidayError is not null)
                                {
                                    <div class="alert alert-danger mt-2 mb-0">@_holidayError</div>
                                }
                            </div>
                        </div>

                        @if (_calendar.Holidays.Count == 0)
                        {
                            <div class="glpi-config-placeholder">
                                <i class="ti ti-beach"></i>
                                <p class="mb-0">Aucune fermeture.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Intitulé</th>
                                            <th>Du</th>
                                            <th>Au</th>
                                            <th>Récurrence</th>
                                            <th style="width: 3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (CalendarHoliday holiday in _calendar.Holidays.OrderBy(h => h.StartDate))
                                        {
                                            <tr>
                                                <td>@holiday.Name</td>
                                                <td class="text-secondary">@Display.LocalDate(holiday.StartDate)</td>
                                                <td class="text-secondary">@Display.LocalDate(holiday.EndDate)</td>
                                                <td>
                                                    @if (holiday.IsPerpetual)
                                                    {
                                                        <span class="badge bg-blue-lt">Chaque année</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-secondary">Une seule fois</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="Supprimer"
                                                            @onclick="() => DeleteHolidayAsync(holiday.Id)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "essai":
                        <p class="text-secondary">
                            Vérifier ce que le calendrier produit, avant qu'un ticket réel en
                            dépende : à quelle date tombe une durée ouvrée partant d'un instant donné.
                        </p>

                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Départ</label>
                                <input class="form-control" type="datetime-local" @bind="_probeStart" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Durée</label>
                                <input class="form-control" type="number" min="1" @bind="_probeValue" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Unité</label>
                                <select class="form-select" @bind="_probeUnit">
                                    @foreach (ServiceLevelUnit unit in Enum.GetValues<ServiceLevelUnit>())
                                    {
                                        <option value="@((int)unit)">@ServiceLevelLabels.For(unit)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100" @onclick="Probe">
                                    <i class="ti ti-player-play me-1"></i>Calculer
                                </button>
                            </div>
                        </div>

                        @if (_probeResult is not null)
                        {
                            <div class="alert @(_probeImpossible ? "alert-danger" : "alert-info")">@_probeResult</div>
                        }
                        break;
                }
            </div>
        </div>
    </div>
}
