@page "/assistance/changes/{ChangeId:int}"
@rendermode InteractiveServer

<PageTitle>@(_change is null ? T("Changement") : $"#{_change.Id} {_change.Name}") — GlpiNg</PageTitle>

@if (_change is null)
{
    <div class="card"><div class="card-body text-center text-secondary py-5">@T("Changement introuvable.")</div></div>
}
else
{
    <div class="glping-fiche">
        <div class="glping-fiche-header d-flex align-items-center justify-content-between">
            <h2 class="mb-0">
                <i class="ti ti-replace me-2"></i>
                <span class="text-secondary">#@_change.Id</span> @_change.Name
                <span class="badge @ChangeLabels.BadgeFor(_change.Status) ms-2">@ChangeLabels.For(_change.Status)</span>
                @if (_change.GlobalValidation != ChangeValidationStatus.None)
                {
                    <span class="badge @ChangeLabels.BadgeFor(_change.GlobalValidation) ms-1"
                          title="@(T("État global des approbations"))">
                        <i class="ti ti-gavel me-1"></i>@ChangeLabels.For(_change.GlobalValidation)
                    </span>
                }
                @if (_change.IsOverdue)
                {
                    <span class="badge bg-danger-lt ms-1">@T("En retard")</span>
                }
            </h2>
            <div class="btn-list">
                <a class="btn" href="/assistance/changes"><i class="ti ti-arrow-left me-1"></i>@T("Retour à la liste")</a>

                @if (_change.IsOpen)
                {
                    <button type="button" class="btn btn-success" @onclick="@(() => _activeTab = "solution")">
                        <i class="ti ti-check me-1"></i>@T("Appliquer")
                    </button>
                }
                else
                {
                    <button type="button" class="btn" @onclick="ReopenAsync">
                        <i class="ti ti-rotate-2 me-1"></i>@T("Rouvrir")
                    </button>
                }

                <div class="dropdown">
                    <button type="button" class="btn btn-icon text-danger" data-bs-toggle="dropdown" aria-expanded="false"
                            title="@(T("Supprimer"))">
                        <i class="ti ti-trash"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 300px;">
                        <p class="mb-2">
                            @T("Supprimer ce changement, ses suivis, tâches et approbations ? Les tickets et problèmes rattachés ne sont pas supprimés, seulement détachés.")
                        </p>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm">@T("Annuler")</button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">@T("Supprimer")</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-warning" disabled="@_isSaving" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1"></i>@T("Enregistrer")
                </button>
            </div>
        </div>

        <div class="glping-fiche-layout">
            <aside class="glping-fiche-sidebar">
                @foreach ((string key, string label, string icon, int? count) in Tabs)
                {
                    <button type="button" class="glping-fiche-tab-item @(_activeTab == key ? "active" : "")"
                            @onclick="() => _activeTab = key">
                        <i class="ti @icon"></i>
                        <span>@T(label)</span>
                        @if (count is { } value)
                        {
                            <span class="glping-fiche-tab-count">@value</span>
                        }
                    </button>
                }
            </aside>

            <div class="glping-fiche-panel">
                @switch (_activeTab)
                {
                    case "fiche":
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Titre")<span class="text-danger ms-1">*</span></label>
                                    <input class="form-control" @bind="_change.Name" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Description")</label>
                                    <textarea class="form-control" rows="6" @bind="_change.Content"></textarea>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Statut")</label>
                                    <select class="form-select" value="@((int)_change.Status)" @onchange="OnStatusChanged">
                                        @foreach (ChangeStatus status in ChangeLabels.Lifecycle)
                                        {
                                            <option value="@((int)status)">@ChangeLabels.For(status)</option>
                                        }
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Catégorie")</label>
                                    <select class="form-select" @bind="_categoryId">
                                        <option value="0">—</option>
                                        @foreach (TicketCategory category in _categories)
                                        {
                                            <option value="@category.Id">@CategoryPath(category)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="glping-fiche-field">
                                    <label>@T("Rédacteur")</label>
                                    <select class="form-select" @bind="_authorId">
                                        <option value="0">—</option>
                                        @foreach (var user in _users)
                                        {
                                            <option value="@user.Id">@user.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Attribué au technicien")</label>
                                    <select class="form-select" @bind="_assignedUserId">
                                        <option value="0">—</option>
                                        @foreach (var user in _users)
                                        {
                                            <option value="@user.Id">@user.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Attribué au groupe")</label>
                                    <select class="form-select" @bind="_assignedGroupId">
                                        <option value="0">—</option>
                                        @foreach (var group in _groups)
                                        {
                                            <option value="@group.Id">@group.Name</option>
                                        }
                                    </select>
                                </div>

                                <hr />

                                <div class="row">
                                    <div class="col-6">
                                        <div class="glping-fiche-field">
                                            <label>@T("Urgence")</label>
                                            <select class="form-select" value="@((int)_change.Urgency)"
                                                    @onchange="OnUrgencyChanged">
                                                @foreach (ItilLevel level in Enum.GetValues<ItilLevel>())
                                                {
                                                    <option value="@((int)level)">@ItilLabels.For(level)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="glping-fiche-field">
                                            <label>@T("Impact")</label>
                                            <select class="form-select" value="@((int)_change.Impact)"
                                                    @onchange="OnImpactChanged">
                                                @foreach (ItilLevel level in Enum.GetValues<ItilLevel>())
                                                {
                                                    <option value="@((int)level)">@ItilLabels.For(level)</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="glping-fiche-field">
                                    <label>
                                        @T("Priorité")
                                        @if (!_change.IsPriorityManual)
                                        {
                                            <span class="text-secondary ms-1">@T("(calculée)")</span>
                                        }
                                    </label>
                                    <div class="d-flex align-items-center gap-2">
                                        <select class="form-select" value="@((int)_change.Priority)"
                                                @onchange="OnPriorityChanged">
                                            @foreach (ItilLevel level in Enum.GetValues<ItilLevel>())
                                            {
                                                <option value="@((int)level)">@ItilLabels.For(level)</option>
                                            }
                                        </select>
                                        @if (_change.IsPriorityManual)
                                        {
                                            <button type="button" class="btn btn-sm text-nowrap" @onclick="ResetPriority"
                                                    title="@(T("Revenir à la priorité déduite de l'urgence et de l'impact"))">
                                                <i class="ti ti-refresh me-1"></i>@T("Recalculer")
                                            </button>
                                        }
                                    </div>
                                </div>
                                @if (_change.IsPriorityManual)
                                {
                                    <p class="hint">@T("Forcée à la main : elle ne suivra plus l'urgence ni l'impact.")</p>
                                }

                                <div class="glping-fiche-field">
                                    <label>@T("Échéance")</label>
                                    <input class="form-control" type="datetime-local" @bind="_change.DueDate" />
                                </div>
                                <div class="glping-fiche-field">
                                    <label>@T("Ouvert le")</label>
                                    <input class="form-control" disabled
                                           value="@Display.DateTime(_change.OpenedAt)" />
                                </div>
                                @if (_change.SolvedAt is { } solved)
                                {
                                    <div class="glping-fiche-field">
                                        <label>@T("Appliqué le")</label>
                                        <input class="form-control" disabled
                                               value="@Display.DateTime(solved)" />
                                    </div>
                                }
                            </div>
                        </div>
                        break;

                    case "analyse":
                        <p class="text-secondary">
                            @T("Avant de toucher à ce qui marche : ce que le changement impacte, et ce qu'on vérifie pour s'assurer qu'il est sans risque.")
                        </p>

                        <div class="glping-fiche-field">
                            <label>@T("Impacts")</label>
                            <textarea class="form-control" rows="6"
                                      placeholder="@(T("Services, utilisateurs, dépendances touchés ; interruption prévue…"))"
                                      @bind="_change.ImpactContent"></textarea>
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Liste de contrôle")</label>
                            <textarea class="form-control" rows="6"
                                      placeholder="@(T("Ce qu'on vérifie avant de décider : prérequis, compatibilité, sauvegardes…"))"
                                      @bind="_change.ControlListContent"></textarea>
                        </div>
                        break;

                    case "plans":
                        <p class="text-secondary">
                            @T("Comment on l'applique, comment on revient en arrière si ça tourne mal, et ce qu'on coche le jour J.")
                        </p>

                        <div class="glping-fiche-field">
                            <label>@T("Plan de déploiement")</label>
                            <textarea class="form-control" rows="6"
                                      placeholder="@(T("Étapes d'application, ordre, fenêtre d'intervention…"))"
                                      @bind="_change.RolloutPlanContent"></textarea>
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Plan de retour arrière")</label>
                            <textarea class="form-control" rows="6"
                                      placeholder="@(T("Comment revenir à l'état d'avant, et à partir de quand le décider…"))"
                                      @bind="_change.BackoutPlanContent"></textarea>
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Checklist")</label>
                            <textarea class="form-control" rows="6"
                                      placeholder="@(T("Les points à cocher pendant et après l'application…"))"
                                      @bind="_change.ChecklistContent"></textarea>
                        </div>
                        break;

                    case "approbations":
                        <p class="text-secondary">
                            @T("Un changement se fait approuver avant d'être appliqué. Un refus suffit à le refuser ; il faut l'accord de chaque approbateur pour qu'il soit accepté.")
                        </p>

                        @if (_change.GlobalValidation == ChangeValidationStatus.Refused)
                        {
                            <div class="alert alert-danger">
                                @T("Approbation refusée : revoyez le changement, ou demandez une nouvelle approbation.")
                            </div>
                        }
                        else if (_change.GlobalValidation == ChangeValidationStatus.Accepted)
                        {
                            <div class="alert alert-success">@T("Changement approuvé par tous les approbateurs sollicités.")</div>
                        }

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label">@T("Approbateur")</label>
                                        <select class="form-select" @bind="_validatorToRequest">
                                            <option value="0">—</option>
                                            @foreach (var user in _users)
                                            {
                                                <option value="@user.Id">@user.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@T("Commentaire de la demande")</label>
                                        <input class="form-control" @bind="_validationRequestComment" @bind:event="oninput"
                                               placeholder="@(T("Ce sur quoi l'avis est attendu…"))" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100"
                                                disabled="@(_validatorToRequest == 0 || _validatorAlreadyWaiting)" @onclick="RequestValidationAsync">
                                            <i class="ti ti-send me-1"></i>@T("Demander")
                                        </button>
                                    </div>
                                </div>
                                @if (_validatorAlreadyWaiting)
                                {
                                    <p class="hint text-warning mt-2 mb-0">
                                        @T("Une approbation de cet utilisateur est déjà en attente.")
                                    </p>
                                }
                            </div>
                        </div>

                        @if (_validations.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-gavel"></i>
                                <p class="mb-0">@T("Aucune approbation demandée.")</p>
                            </div>
                        }
                        else
                        {
                            @foreach (ChangeValidation validation in _validations)
                            {
                                <div class="card mb-2">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <span class="fw-semibold"><i class="ti ti-user me-1"></i>@NameOfUser(validation.ValidatorUserId)</span>
                                                <span class="badge @ChangeLabels.BadgeFor(validation.Status) ms-2">@ChangeLabels.For(validation.Status)</span>
                                            </div>
                                            @if (validation.Status == ChangeValidationStatus.Waiting)
                                            {
                                                <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Retirer la demande"))"
                                                        @onclick="() => DeleteValidationAsync(validation.Id)">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            }
                                        </div>
                                        <div class="text-secondary small mt-1">
                                            Demandée par @(validation.RequesterName ?? "?") le
                                            @Display.DateTime(validation.SubmittedAt)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(validation.RequestComment))
                                        {
                                            <div class="mt-2" style="white-space: pre-wrap;">@validation.RequestComment</div>
                                        }

                                        @if (validation.ValidatedAt is { } answeredAt)
                                        {
                                            <div class="border-top mt-2 pt-2">
                                                <div class="text-secondary small">
                                                    @T("Réponse le {0}", Display.DateTime(answeredAt))
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(validation.ValidationComment))
                                                {
                                                    <div style="white-space: pre-wrap;">@validation.ValidationComment</div>
                                                }
                                            </div>
                                        }
                                        else if (validation.ValidatorUserId == _currentUserId)
                                        {
                                            @* Seul l'approbateur désigné répond : une approbation donnée par un autre
                                               n'en serait pas une. *@
                                            <div class="border-top mt-2 pt-2">
                                                <textarea class="form-control mb-2" rows="2" placeholder="@(T("Votre réponse (obligatoire pour un refus)…"))"
                                                          value="@_answers.GetValueOrDefault(validation.Id)"
                                                          @oninput="@(e => _answers[validation.Id] = e.Value?.ToString() ?? string.Empty)"></textarea>
                                                <button type="button" class="btn btn-success btn-sm"
                                                        @onclick="() => AnswerValidationAsync(validation.Id, ChangeValidationStatus.Accepted)">
                                                    <i class="ti ti-check me-1"></i>@T("Accepter")
                                                </button>
                                                <button type="button" class="btn btn-danger btn-sm ms-1"
                                                        disabled="@string.IsNullOrWhiteSpace(_answers.GetValueOrDefault(validation.Id))"
                                                        @onclick="() => AnswerValidationAsync(validation.Id, ChangeValidationStatus.Refused)">
                                                    <i class="ti ti-x me-1"></i>@T("Refuser")
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        break;

                    case "tickets":
                        <p class="text-secondary">
                            @T("Les tickets à l'origine de ce changement, ou qu'il vient régler.")
                        </p>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-10">
                                        <label class="form-label">@T("Rattacher un ticket")</label>
                                        <select class="form-select" @bind="_ticketToAttach">
                                            <option value="0">—</option>
                                            @foreach (Ticket candidate in _ticketCandidates)
                                            {
                                                <option value="@candidate.Id">
                                                    #@candidate.Id @candidate.Name (@TicketLabels.For(candidate.Status))
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100"
                                                disabled="@(_ticketToAttach == 0)" @onclick="AttachTicketAsync">
                                            <i class="ti ti-link me-1"></i>@T("Rattacher")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (_tickets.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-ticket-off"></i>
                                <p class="mb-0">@T("Aucun ticket rattaché.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th style="width: 5rem;">N°</th>
                                            <th>@T("Titre")</th>
                                            <th>@T("Statut")</th>
                                            <th>@T("Priorité")</th>
                                            <th>@T("Ouvert le")</th>
                                            <th style="width: 3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Ticket ticket in _tickets)
                                        {
                                            <tr>
                                                <td class="text-secondary">@ticket.Id</td>
                                                <td>
                                                    <a href="@($"/assistance/tickets/{ticket.Id}")" class="text-reset fw-semibold">@ticket.Name</a>
                                                </td>
                                                <td><span class="badge @TicketLabels.BadgeFor(ticket.Status)">@TicketLabels.For(ticket.Status)</span></td>
                                                <td><span class="badge @ItilLabels.BadgeFor(ticket.Priority)">@ItilLabels.For(ticket.Priority)</span></td>
                                                <td class="text-secondary">@Display.DateTime(ticket.OpenedAt)</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Détacher"))"
                                                            @onclick="() => DetachTicketAsync(ticket.Id)">
                                                        <i class="ti ti-unlink"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "problemes":
                        <p class="text-secondary">
                            @T("Les problèmes dont ce changement traite la cause.")
                        </p>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-10">
                                        <label class="form-label">@T("Rattacher un problème")</label>
                                        <select class="form-select" @bind="_problemToAttach">
                                            <option value="0">—</option>
                                            @foreach (Problem candidate in _problemCandidates)
                                            {
                                                <option value="@candidate.Id">
                                                    #@candidate.Id @candidate.Name (@ProblemLabels.For(candidate.Status))
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-primary w-100"
                                                disabled="@(_problemToAttach == 0)" @onclick="AttachProblemAsync">
                                            <i class="ti ti-link me-1"></i>@T("Rattacher")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (_problems.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-bulb-off"></i>
                                <p class="mb-0">@T("Aucun problème rattaché.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th style="width: 5rem;">N°</th>
                                            <th>@T("Titre")</th>
                                            <th>@T("Statut")</th>
                                            <th>@T("Priorité")</th>
                                            <th>@T("Ouvert le")</th>
                                            <th style="width: 3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (Problem problem in _problems)
                                        {
                                            <tr>
                                                <td class="text-secondary">@problem.Id</td>
                                                <td>
                                                    <a href="@($"/assistance/problems/{problem.Id}")" class="text-reset fw-semibold">
                                                        <i class="ti ti-bulb me-1 text-secondary"></i>@problem.Name
                                                    </a>
                                                </td>
                                                <td><span class="badge @ProblemLabels.BadgeFor(problem.Status)">@ProblemLabels.For(problem.Status)</span></td>
                                                <td><span class="badge @ItilLabels.BadgeFor(problem.Priority)">@ItilLabels.For(problem.Priority)</span></td>
                                                <td class="text-secondary">@Display.DateTime(problem.OpenedAt)</td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Détacher"))"
                                                            @onclick="() => DetachProblemAsync(problem.Id)">
                                                        <i class="ti ti-unlink"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "suivis":
                        <p class="text-secondary">
                            @T("Le fil du changement. Un suivi interne reste entre intervenants.")
                        </p>

                        <div class="mb-3">
                            <textarea class="form-control" rows="3" placeholder="@(T("Ajouter un suivi…"))"
                                      @bind="_newFollowup" @bind:event="oninput"></textarea>
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <button type="button" class="btn btn-primary"
                                        disabled="@string.IsNullOrWhiteSpace(_newFollowup)" @onclick="AddFollowupAsync">
                                    <i class="ti ti-plus me-1"></i>@T("Ajouter")
                                </button>
                                <label class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" checked="@_newFollowupPrivate"
                                           @onchange="@((ChangeEventArgs e) => _newFollowupPrivate = (bool)(e.Value ?? false))" />
                                    <span class="form-check-label">@T("Suivi interne")</span>
                                </label>
                            </div>
                        </div>

                        @if (_followups.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-message-off"></i>
                                <p class="mb-0">@T("Aucun suivi.")</p>
                            </div>
                        }
                        else
                        {
                            @foreach (ItilFollowup followup in Display.Chronological(_followups, followup => followup.CreatedAt))
                            {
                                <div class="card mb-2 @(followup.IsPrivate ? "border-warning" : "")">
                                    <div class="card-body">
                                        <div style="white-space: pre-wrap;">@followup.Content</div>
                                        <div class="d-flex align-items-center justify-content-between mt-2">
                                            <div class="text-secondary small">
                                                <i class="ti ti-user me-1"></i>@followup.AuthorName
                                                <span class="ms-2">
                                                    <i class="ti ti-calendar me-1"></i>@Display.DateTime(followup.CreatedAt)
                                                </span>
                                                @if (followup.IsPrivate)
                                                {
                                                    <span class="badge bg-warning-lt ms-2">@T("Interne")</span>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Supprimer"))"
                                                    @onclick="() => DeleteFollowupAsync(followup.Id)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        break;

                    case "taches":
                        <p class="text-secondary">
                            @T("Travaux de préparation, d'application ou de vérification, planifiables et attribuables.")
                        </p>

                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label">@T("Tâche")</label>
                                        <input class="form-control" @bind="_newTask.Content" @bind:event="oninput" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@T("Technicien")</label>
                                        <select class="form-select" @bind="_newTaskUserId">
                                            <option value="0">—</option>
                                            @foreach (var user in _users)
                                            {
                                                <option value="@user.Id">@user.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@T("Planifiée le")</label>
                                        <input class="form-control" type="datetime-local" @bind="_newTask.PlannedStart" />
                                    </div>
                                    <div class="col-md-1">
                                        <button type="button" class="btn btn-primary w-100"
                                                disabled="@string.IsNullOrWhiteSpace(_newTask.Content)" @onclick="AddTaskAsync">
                                            <i class="ti ti-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (_tasks.Count == 0)
                        {
                            <div class="glping-config-placeholder">
                                <i class="ti ti-checklist"></i>
                                <p class="mb-0">@T("Aucune tâche.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th style="width: 3rem;"></th>
                                            <th>@T("Tâche")</th>
                                            <th>@T("Technicien")</th>
                                            <th>@T("Planifiée")</th>
                                            <th>@T("Durée")</th>
                                            <th style="width: 3rem;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ItilTask task in _tasks)
                                        {
                                            <tr>
                                                <td>
                                                    <input class="form-check-input m-0" type="checkbox"
                                                           checked="@(task.State == ItilTaskState.Done)"
                                                           @onchange="@((ChangeEventArgs e) => ToggleTaskAsync(task.Id, (bool)(e.Value ?? false)))" />
                                                </td>
                                                <td class="@(task.State == ItilTaskState.Done ? "text-secondary text-decoration-line-through" : "")">
                                                    @task.Content
                                                </td>
                                                <td class="text-secondary">
                                                    @(task.AssignedUserId is { } id ? NameOfUser(id) : "—")
                                                </td>
                                                <td class="text-secondary">
                                                    @(Display.LocalDateTime(task.PlannedStart) ?? "—")
                                                </td>
                                                <td class="text-secondary">
                                                    @(task.DurationMinutes is { } minutes ? $"{minutes} min" : "—")
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-icon btn-sm text-danger" title="@(T("Supprimer"))"
                                                            @onclick="() => DeleteTaskAsync(task.Id)">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case "solution":
                        string appliedOn = _change.SolvedAt is { } solvedDate
                            ? T(" le {0}", Display.DateTime(solvedDate))
                            : string.Empty;

                        @if (_change.Status is ChangeStatus.Observed)
                        {
                            <div class="alert alert-info">
                                @T("Changement appliqué{0}, en revue : il reste ouvert tant que son effet n'est pas confirmé.", appliedOn)
                            </div>
                        }
                        else if (_change.Status is ChangeStatus.Canceled)
                        {
                            <div class="alert alert-secondary">@T("Changement annulé sans avoir été appliqué.")</div>
                        }
                        else if (!_change.IsOpen)
                        {
                            <div class="alert alert-success">
                                @T("Changement {0}{1}.", ChangeLabels.For(_change.Status).ToLowerInvariant(), appliedOn)
                            </div>
                        }
                        else
                        {
                            @* Mises en garde, pas des blocages : GLPI n'empêche pas d'appliquer un
                               changement non approuvé, mais c'est le moment de le rappeler. *@
                            @if (_change.GlobalValidation != ChangeValidationStatus.Accepted)
                            {
                                <div class="alert alert-warning">
                                    @T("Ce changement n'est pas approuvé (approbation : {0}).", ChangeLabels.For(_change.GlobalValidation).ToLowerInvariant())
                                </div>
                            }
                            @if (string.IsNullOrWhiteSpace(_change.BackoutPlanContent))
                            {
                                <div class="alert alert-warning">
                                    @T("Aucun plan de retour arrière : rien ne dit comment revenir en arrière si l'application tourne mal (onglet Plans).")
                                </div>
                            }
                        }

                        <div class="glping-fiche-field">
                            <label>@T("Type de solution")</label>
                            <input class="form-control" placeholder="@(T("Mise à jour, changement de configuration…"))"
                                   @bind="_change.SolutionType" />
                        </div>
                        <div class="glping-fiche-field">
                            <label>@T("Compte rendu d'application")</label>
                            <textarea class="form-control" rows="6" @bind="_change.Solution" @bind:event="oninput"></textarea>
                        </div>

                        @if (_change.IsOpen)
                        {
                            <button type="button" class="btn btn-success" disabled="@string.IsNullOrWhiteSpace(_change.Solution)"
                                    @onclick="ApplyAsync">
                                <i class="ti ti-check me-1"></i>
                                @(_change.Status is ChangeStatus.Observed ? T("Confirmer l'application") : T("Marquer comme appliqué"))
                            </button>

                            @if (_change.Status is not ChangeStatus.Observed)
                            {
                                <button type="button" class="btn ms-2" disabled="@string.IsNullOrWhiteSpace(_change.Solution)"
                                        @onclick="ReviewAsync">
                                    <i class="ti ti-eye me-1"></i>@T("Mettre en revue")
                                </button>
                            }

                            <button type="button" class="btn ms-2 text-danger" @onclick="CancelAsync">
                                <i class="ti ti-ban me-1"></i>@T("Annuler le changement")
                            </button>
                            <p class="hint">
                                @T("« En revue » enregistre l'application sans clore le changement : à choisir tant qu'on vérifie qu'il a produit l'effet voulu.")
                            </p>
                        }
                        else if (_change.Status is ChangeStatus.Solved)
                        {
                            <button type="button" class="btn" @onclick="CloseAsync">
                                <i class="ti ti-lock me-1"></i>@T("Clore le changement")
                            </button>
                        }
                        break;

                    case "documents":
                        <ItemDocumentsTab ItemType="@ItemTypes.Change" ItemId="ChangeId" AuthorName="@_currentUserName"
                                          CountChanged="count => _documentCount = count" />
                        break;

                    case "notes":
                        <ItemNotesTab ItemType="@ItemTypes.Change" ItemId="ChangeId" AuthorName="@_currentUserName"
                                      CountChanged="count => _noteCount = count" />
                        break;

                    case "historique":
                        <ItemHistoryTab Rows="_history" />
                        break;
                }
            </div>
        </div>
    </div>
}
